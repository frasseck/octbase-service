# Production override for client instances — always layered on top of the app
# repo's podman-compose.yml:
#
#   podman-compose -f podman-compose.yml -f podman-compose.client.yml up -d
#
# The base file is tuned for local development: it hardcodes demo mode ON and
# a localhost CORS origin, and does not pass the edition/add-on variables into
# the API container at all (seat/upload limits pass through as of app
# release_v14, but with fail-open blank defaults). This override makes a stack
# production-safe and wires every ledger-managed variable through from .env
# with fail-closed defaults.
#
# TEMPLATED, not a static file: the security_opt blocks below appear only when
# client_apparmor is true in group_vars. With it false — the default, and the
# only thing rootless podman can currently do — the deployed file is what it
# always was, plus this comment. See the AppArmor section of
# inventory/group_vars/all/main.yml.
{% if client_apparmor | bool %}
#
# ⚠ AppArmor confinement IS wired in below. podman_compose.py passes each
# security_opt item verbatim to `podman --security-opt`, so the value has to be
# podman's `apparmor=<profile>` spelling and NOT docker-compose's
# `apparmor:<profile>`, which podman-compose only rewrites for the two
# `:unconfined` special cases. The profiles themselves are laid down on the
# host by setup-host.yml.
{% endif %}
services:
{% if client_apparmor | bool %}
  postgres:
    security_opt:
      - apparmor=octbase-postgres

{% endif %}
  octbase-api:
{% if client_apparmor | bool %}
    security_opt:
      - apparmor=octbase-api
{% endif %}
    environment:
      # Production hardening — the API refuses to start without a strong JWT
      # secret once demo mode is off. Fail-closed .env passthrough: env.j2
      # writes OCTBASE_DEMO_MODE=false for clients; only the platform's own
      # ledger-managed demo instance flips it to true in its .env (seeded
      # demo logins are that instance's purpose).
      OCTBASE_DEMO_MODE: "${OCTBASE_DEMO_MODE:-false}"
      OCTBASE_SECURE_COOKIES: "true"
      OCTBASE_CORS_ORIGIN: "${OCTBASE_CORS_ORIGIN}"
      OCTBASE_JWT_ACCESS_TTL: "${OCTBASE_JWT_ACCESS_TTL:-15m}"
      OCTBASE_JWT_REFRESH_TTL: "${OCTBASE_JWT_REFRESH_TTL:-1h}"
      OCTBASE_LOG_LEVEL: "${OCTBASE_LOG_LEVEL:-info}"
      # Initial administrator, consumed by the API only while the users table
      # is empty (app: internal/bootstrap). Blank default = no bootstrap, which
      # is the right fail-closed behaviour: an instance that already has users
      # must never grow an account from a stray environment variable.
      OCTBASE_BOOTSTRAP_ADMIN_EMAIL: "${OCTBASE_BOOTSTRAP_ADMIN_EMAIL:-}"
      OCTBASE_BOOTSTRAP_ADMIN_PASSWORD_HASH: "${OCTBASE_BOOTSTRAP_ADMIN_PASSWORD_HASH:-}"
      # Commercial configuration from the ledger. Defaults fail CLOSED: a
      # missing .env key must never grant a higher edition or more seats
      # than the client booked.
      OCTBASE_EDITION: "${OCTBASE_EDITION:-TEAM}"
      OCTBASE_OPTION_JIRA_IMPORT: "${OCTBASE_OPTION_JIRA_IMPORT:-false}"
      OCTBASE_MAX_USERS: "${OCTBASE_MAX_USERS:-1}"
      # GDPR retention.
      OCTBASE_AUDIT_RETENTION_DAYS: "${OCTBASE_AUDIT_RETENTION_DAYS:-365}"
      OCTBASE_ACTIVITY_RETENTION_DAYS: "${OCTBASE_ACTIVITY_RETENTION_DAYS:-365}"
      # Webhook HMAC secrets (set in .env when the client books SCM webhooks).
      OCTBASE_WEBHOOK_SECRET_GITHUB: "${OCTBASE_WEBHOOK_SECRET_GITHUB:-}"
      OCTBASE_WEBHOOK_SECRET_BITBUCKET: "${OCTBASE_WEBHOOK_SECRET_BITBUCKET:-}"
      # Attachments: persistent host path (mounted below) instead of the
      # container filesystem, where uploads would die with the container.
      OCTBASE_ATTACHMENTS_DIR: /data/attachments
      # Upload limits — defaults match the product defaults (10 MB per file,
      # 512 MB = 0.5 GB storage per user); 0 disables a limit.
      OCTBASE_MAX_UPLOAD_MB: "${OCTBASE_MAX_UPLOAD_MB:-10}"
      OCTBASE_MAX_USER_STORAGE_MB: "${OCTBASE_MAX_USER_STORAGE_MB:-512}"
      OCTBASE_FEATURE_TASKVIEW: "${OCTBASE_FEATURE_TASKVIEW:-true}"
    volumes:
      - ./attachments:/data/attachments:U

  octbase-frontend:
{% if client_apparmor | bool %}
    security_opt:
      - apparmor=octbase-frontend
{% endif %}
    environment:
      # X-Forwarded-For repair. Rootless podman NATs the edge proxy's
      # 127.0.0.1 connection, so the frontend Caddy sees a compose-network
      # peer for every request; with the app-repo default (trust nobody) it
      # then OVERWRITES the edge's X-Forwarded-For with that NAT address and
      # the API's per-IP rate limiting collapses into one bucket per instance.
      # Trusting the podman network range here is safe ONLY because client
      # stacks bind the frontend to 127.0.0.1 (C9) — the edge proxy is the
      # sole caller, so nobody can reach this port to forge a client IP (see
      # OCTBASE_FRONTEND_TRUSTED_PROXIES in the app repo's .env.example).
      # 10.89.0.0/16 is the default rootless-podman network range, matching
      # octbase_trusted_proxies in group_vars — the API applies that as its
      # own second check on the forwarded chain.
      OCTBASE_FRONTEND_TRUSTED_PROXIES: "${OCTBASE_FRONTEND_TRUSTED_PROXIES:-10.89.0.0/16}"
{% if client_apparmor | bool %}

  # The mobile SPA needs no production override of its own — it is here only to
  # carry its profile, which is why this block exists solely under
  # client_apparmor.
  octbase-mobile:
    security_opt:
      - apparmor=octbase-mobile
{% endif %}
