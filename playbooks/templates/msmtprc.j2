#
# {{ ansible_managed }}
#
# System-wide msmtp configuration, installed by install-monitoring.yml so that
# monitor-all.sh has a working `sendmail` to hand its state-change alerts to.
# Without an MTA the monitor's alert path degrades SILENTLY — it guards on
# `command -v sendmail`, so a host with no MTA drops every alert and says
# nothing (register D28).
#
# This is the same relay the client instances use for transactional mail
# (smtp_* in inventory/group_vars/all/main.yml), so the platform has one mail
# path to keep working, not two. The password comes from vault_smtp_pass in
# the ansible-vault-encrypted vault.yml; the relay rejects unauthenticated
# senders, so a missing vault makes alerts fail loudly instead of disappearing.
#
# Root-only (0600): this file holds the relay password, and msmtp refuses a
# configuration whose permissions are too generous. Only root sends mail here —
# the monitor timer runs as root.

defaults
auth            on
tls             on
tls_starttls    on
tls_trust_file  /etc/ssl/certs/ca-certificates.crt
logfile         /var/log/msmtp.log

account         octbase
host            {{ smtp_host }}
port            {{ smtp_port }}
from            {{ smtp_from }}
user            {{ smtp_user }}
password        {{ smtp_pass }}

account default : octbase
