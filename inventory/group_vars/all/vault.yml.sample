# Ansible Vault template for the platform's SMTP relay password — the only
# secret this repo carries (per-client secrets are generated at first deploy
# and live only in the client's .env on the server).
#
# STATUS 2026-08-07: main.yml names the relay v091380.kasserver.com:587 with
# user m080f437, sending as noreply@octbase.io. Verified against the live relay
# on 2026-08-07: it offers STARTTLS and AUTH PLAIN (what the Go mailer speaks),
# m080f437 authenticates, and MAIL FROM <noreply@octbase.io> is accepted — the
# relay does not require the envelope sender to equal the authenticated mailbox.
#
# If vault.yml is absent, smtp_pass resolves to '' and every client ships
# OCTBASE_SMTP_PASS= in its .env. That does NOT fall back to "no auth": the API
# sees a non-empty OCTBASE_SMTP_USER, attempts AUTH PLAIN with a blank password,
# and the relay rejects it — so every mail fails at the same point, and a
# password reset silently never arrives (auth/forgot-password answers 202
# regardless, by design). Creating the vault cannot be done from the production
# host — ansible-vault is not installed there, deliberately.
#
# ⚠ The password is m080f437's own, and it is NOT the one in
# ~/credentials/.env.octbase-web. That file's WEB_SMTP_PASSWORD belongs to
# m07fb762, the marketing contact form's separate mailbox — this file used to
# name it as the source, from when both shared one mailbox. Pasting it here
# authenticates as the wrong account and fails exactly like a wrong password.
# Copy m080f437's password over a secure channel; do not commit it anywhere in
# plain text, and do not paste it into a chat.
#
# After creating the vault, the relay reaches existing clients only when
# create-instance.yml is re-run for each of them — the SMTP keys are
# platform-managed and re-synced on every run. Every client, not just the two
# this loop used to name:
#
#     for c in archivenodes beyags demo educaplan educaswiss nicolestutz; do
#       ansible-playbook playbooks/create-instance.yml -e client=$c --ask-vault-pass
#     done
#
# (Derive the list from ledger/clients/*.yml rather than trusting this one —
# a client added later and not re-run keeps sending nothing.)
#
# Do NOT copy this file into place in plain text. Create the real vault.yml
# encrypted, from the admin machine:
#
#     ansible-vault create inventory/group_vars/all/vault.yml
#
# then paste the line below with the real password. To change it later:
#
#     ansible-vault edit inventory/group_vars/all/vault.yml
#     ansible-vault view inventory/group_vars/all/vault.yml   # read-only check
#
# vault.yml IS committed — it is ciphertext. The vault password itself is not
# in this repo; see README "Secrets & the SMTP vault" for where it is kept.
#
# Every playbook run then needs the vault password:
#
#     ansible-playbook playbooks/create-instance.yml -e client=acme --ask-vault-pass
#
# or, to avoid the prompt, point Ansible at a password file kept outside the
# repo (mode 0600): export ANSIBLE_VAULT_PASSWORD_FILE=~/.octbase-vault-pass

# Consumed by smtp_pass in main.yml. Empty/absent = unauthenticated relay.
vault_smtp_pass: "change-me"
